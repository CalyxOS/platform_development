package {
    // See: http://go/android-license-faq
    default_applicable_licenses: [
        "Android-Apache-2.0",
        "development_tools_license",
    ],
}

license {
    name: "development_tools_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "legacy_unencumbered",
    ],
}

subdirs = ["*"]

genrule {
    name: "otatools_package_make_key",
    tools: ["soong_zip"],
    srcs: [
        "make_key",
    ],
    cmd: "find development/tools -type f | sort > $(genDir)/files.txt && " +
        "$(location soong_zip) -o $(out) -l $(genDir)/files.txt",
    out: ["otatools_package_make_key.zip"],
}
